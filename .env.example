# Anthropic API Key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Brave Search API Key (https://brave.com/search/api/)
# Already configured in MCP — copy the same key here
BRAVE_API_KEY=your-brave-api-key-here

# Gmail - adresse expéditrice
GMAIL_FROM=your-gmail@gmail.com
FROM_NAME=Daily News Agent

# Destinataires de la newsletter
# Priorité : config/recipients.toml (géré automatiquement par Google Apps Script)
# Fallback : GMAIL_TO ci-dessous (utilisé si recipients.toml est absent ou vide)
GMAIL_TO=recipient@example.com,second@example.com,third@example.com

# Google Form — sync automatique des destinataires
# ID de la Google Sheet liée au formulaire d'inscription
# (visible dans l'URL : docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=your-google-sheet-id-here

# Gmail OAuth2 credentials (télécharger depuis Google Cloud Console)
# Voir README pour les instructions d'authentification
GMAIL_CREDENTIALS_PATH=~/.gmail-mcp/credentials.json
GMAIL_TOKEN_PATH=~/.gmail-mcp/token.json

# Gmail re-auth automatique (token expiré)
# GMAIL_APP_PASSWORD : mot de passe d'application Gmail (différent du token OAuth)
#   → Compte Google → Sécurité → Mots de passe des applications
GMAIL_APP_PASSWORD=xxxxxxx
# AUTH_SERVER_URL : URL publique du serveur auth_server/ (Railway/Render)
AUTH_SERVER_URL=https://your-app.railway.app

# ─── Interactions lecteur (désinscription, suivi, feedback) ───────────────────
# UNSUBSCRIBE_SECRET : secret HMAC signant TOUS les liens personnalisés
#   (désinscription, refus de mesure, pixel, redirections de clic, feedback).
#   ⚠️ Doit être IDENTIQUE en local, en CI et sur le serveur déployé : le
#   serveur revérifie chaque jeton, une valeur différente les rejette tous.
#   Sans lui, aucun de ces liens n'est généré — les emails partent sans
#   lien de désinscription.
#   → Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
UNSUBSCRIBE_SECRET=change-me-valeur-aleatoire-longue

# FEEDBACK_FORM_URL : formulaire de retour, en repli si les boutons de
#   réaction signés ne sont pas disponibles (optionnel)
FEEDBACK_FORM_URL=

# ─── Tableau de bord ─────────────────────────────────────────────────────────
# STATS_TOKEN : protège /dashboard et /stats/<date> (payload complet).
#   ⚠️ Ne JAMAIS mettre une URL contenant ce jeton dans un email : elle serait
#   diffusée à tous les abonnés, et un seul transfert suffit à la faire fuiter.
#   → Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
STATS_TOKEN=change-me-valeur-aleatoire-longue

# DASHBOARD_PUBLIC_URL : route /board — même chiffres, sans jeton, filtrés par
#   liste blanche. C'est CETTE URL qui va dans la newsletter.
DASHBOARD_PUBLIC_URL=https://your-app.railway.app/board

# ─── Bloc transparence (mesure d'audience annoncée aux lecteurs) ─────────────
# SHOW_TRACKING_NOTICE : 1 pour afficher le bloc dans la newsletter.
#   Laisser vide tant que /tracking-optout et /board ne répondent pas : le bloc
#   est de toute façon supprimé si un lien d'action manque.
SHOW_TRACKING_NOTICE=

# PRIVACY_URL : page détaillant les données collectées (optionnel).
#   Servie par auth_server sur /vie-privee — publique, indexable, sans dépendance.
#   Sans elle, la ligne « le détail de ce qui est collecté » disparaît du bloc.
PRIVACY_URL=https://your-app.railway.app/vie-privee

# ─── GitHub — écriture des données depuis le serveur et le pipeline ──────────
# GIT_TOKEN : PAT avec le scope "repo". Utilisé par agent.py pour pousser les
#   articles du jour, et par auth_server pour écrire unsubscribed.toml,
#   tracking_optout.toml et les CSV de mesures.
#   Sur Railway, la même valeur est attendue sous le nom GITHUB_TOKEN.
# DATA_REPO : dépôt PRIVÉ hébergeant les données d'abonnés (#55).
#   recipients.toml, unsubscribed.toml, subscriber_ids.toml, tracking_optout.toml
#   y vivent, pour que ce dépôt-ci puisse être ouvert. Rapatriées en local par
#   scripts/fetch_subscriber_data.py, jamais commitées ici.
#   ⚠️ Le jeton doit avoir accès AUX DEUX dépôts.
DATA_REPO=yousmaaza/newsletter-data

GIT_TOKEN=ghp_your-personal-access-token
GITHUB_TOKEN=ghp_your-personal-access-token
GITHUB_REPO=yousmaaza/newletter-ai

# ─── Renouvellement OAuth Gmail depuis auth_server (optionnel) ───────────────
# Client OAuth2 « Desktop app » de la Google Cloud Console — permet au serveur
# de régénérer le token Gmail via /auth et /callback sans intervention locale.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PORT : injecté automatiquement par Railway/Render — ne pas définir en local
# PORT=8080

# News settings (optionnel)
NEWS_TOPICS=technologie,science,business,monde,santé
NEWS_COUNT=10

# Scheduler (optionnel, défaut: 08:00 Europe/Paris)
SCHEDULE_TIME=08:00
TIMEZONE=Europe/Paris

# ─── Git — repli pour la reconstitution de GITHUB_REPO ───────────────────────
# agent.py pousse les articles du jour sur GitHub. Il lit GITHUB_REPO en
# priorité ; sans lui, il recompose « GIT_USERNAME/GIT_REPO ».
GIT_USERNAME=yousmaaza
GIT_REPO=newletter-ai
